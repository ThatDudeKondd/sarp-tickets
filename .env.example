SARP_TICKETS_BOT_TOKEN=
SARP_TICKETS_CLIENT_ID=
BLOXLINK_API_KEY=
DATABASE_URL="postgresql://user:password@localhost:5432/sarp_tickets"
INTERNAL_TRANSCRIPT_URL=http://127.0.0.1:4001
INTERNAL_TRANSCRIPT_SECRET=
# djsko owner console. Comma-separated Discord user IDs, no spaces/quotes
# (Docker --env-file is strict). Unset = console disabled, not app-owner fallback.
JSK_OWNERS=
JSK_SHELL_OWNERS=

# Shared with webhook-server.cjs for `jsk promote` (>= 32 chars, same value in both bots).
# Generate: openssl rand -base64 48
PROMOTE_SECRET=
